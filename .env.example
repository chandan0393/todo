# Secret phrase typed into the task field (default: message)
VITE_SECRET_KEYWORD=message

# local | firebase
VITE_BACKEND=local

# Required only when VITE_BACKEND=firebase
# Firebase web keys are public identifiers; protect data with Auth + security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Local API (server)
PORT=3001
JWT_SECRET=change-this-in-production
